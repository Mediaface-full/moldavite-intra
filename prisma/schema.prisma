generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

// ─── Cenotvorba / Zakázky (Etapa 1) ──────────────────────────────
// Nové entity zavádějí "Order" jako batch nákupu. Etapa 1 přidává
// SCHEMA a výpočtový modul (lib/pricing/*). Žádné API ani UI ještě
// neexistuje — nová pole na Item a Box jsou NULLABLE aby existující
// produkční chování nebylo dotčeno.

enum AllocationMethod {
  BY_WEIGHT          // default — alokace nákladů zakázky podle gramáže
  BY_PURCHASE_PRICE  // dražší kameny dostanou větší část společných nákladů
  EQUAL_PER_PIECE    // rovnoměrně na kus
}

enum OrderStatus {
  DRAFT      // rozpracovaná, ceny ještě nespočítané
  PRICED     // ceny spočtené, kameny lze publikovat
  PUBLISHED  // kameny propsané na shop/Etsy
  CANCELLED  // stornovaná — ceny zůstávají jako snapshot, ale neaktualizují se
  ARCHIVED
}

enum PricingStatus {
  NEEDS_INPUT   // chybí váha / PPG / atribut s missingPolicy=error
  NEEDS_REVIEW  // manualPrice spadla pod nový recommendedPrice po přepočtu
  OK            // spočtené a platné
  STALE         // konfigurace nebo náklady zakázky se změnily od posledního výpočtu
}

/// Typ kazety (Box) — co je v ní fyzicky uložené.
/// V UI se Box prezentuje jako "Kazeta".
///
/// POZN.: Sloupec Box.cassetteType je String (ne enum) — povolené hodnoty
/// jsou řízené přes AttrOption(attrKey="cassetteType") a editovatelné
/// v admin sekci /admin/attributes. Default a 4 výchozí hodnoty viz
/// scripts/seed-attr-options.mjs:
///   - "Kameny" (default — surové vltavíny)
///   - "Opracované kusy" (broušené / leštěné)
///   - "K opracování" (určené k dalšímu opracování)
///   - "Prach" (drobný materiál)

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  role         Role          @default(USER)
  tokenVersion Int           @default(0) // bump = invaliduje všechny existující JWT tokeny uživatele
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "item.update", "item.sold", "export.upgates"
  target    String   @default("") // e.g. "K0001-0005"
  details   String   @default("") // JSON or text details
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Kazeta (DB model historicky "Box"). V UI se prezentuje jako "Kazeta".
/// Drží kameny, je vázaná na zakázku (Order). cassetteType (String, řízeno
/// AttrOption) ovlivňuje badge na výpisu.
///
/// Kazeta může mít vlastní data co přebijí defaulty zakázky:
///   - sellerId      — dodavatel (jinak dědí Order.sellerId)
///   - declaredPieces, declaredWeight — kolik kamenů / kolik gramů reálně
///                     přišlo (může se lišit od declared na zakázce)
///   - purchaseAmountCzk — kolik kazeta stála (Σ za zakázku by mělo sedět
///                     na Order.totalPurchaseAmountCzk; jinak UI warning)
///   - purchasePricePerGramCzk — cena za gram pro výpočet ceny kamenů v kazetě
///                     (jinak dědí Order.defaultPurchasePricePerGramCzk)
model Box {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. "K0001"
  name      String?
  placement String   @default("") // kde je kazeta umístěna
  photos    String[] @default([]) // až 5 fotek kazety (cesty)
  /// Řízeno přes AttrOption(attrKey="cassetteType"); default "Kameny"
  cassetteType String  @default("Kameny")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]

  // Zakázka (Etapa 1, nullable do migrace dat):
  // - orderId NULL → "skladová kazeta" (fyzická lokace, kameny mohou patřit různým Order)
  // - orderId set  → "objednávková kazeta" (všechny Items v ní MUSÍ mít stejné orderId)
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Dodavatel (override Order.sellerId)
  sellerId Int?
  seller   Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  // Per-kazeta cenotvorba / deklarace (vše nullable → dědí z Order)
  declaredPieces           Int?
  declaredWeight           Decimal? @db.Decimal(10, 2)
  purchaseAmountCzk        Decimal? @db.Decimal(12, 2)
  purchasePricePerGramCzk  Decimal? @db.Decimal(10, 2)

  @@index([orderId])
  @@index([sellerId])
  @@index([cassetteType])
}

/// Dodavatel kamenů. Může být přiřazen na úrovni zakázky (Order.sellerId)
/// nebo per kazeta (Box.sellerId override). V UI listingu zakázky:
///   - všechny kazety stejný seller → ukáže se v Order header
///   - smíšené → UI badge "MIX (N dodavatelů)"
///
/// Soft-delete přes active=false (stávající Order/Box si reference nechají).
model Seller {
  id        Int      @id @default(autoincrement())
  firstName String   @default("")
  lastName  String   @default("")
  alias     String   @default("") // krycí jméno / přezdívka
  phone     String   @default("")
  email     String   @default("")
  note      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  boxes  Box[]

  @@index([active])
  @@index([lastName])
}

/// Řízené hodnoty atributů (categorical dictionary).
/// Místo hardcoded TS souborů jsou hodnoty editovatelné v admin UI
/// (/admin/attributes). attrKey rozlišuje doménu:
///   - 'pasShape'    — tvar (Běžný, Kapka, Tyčka, ...)
///   - 'attrDamage'  — poškození (Bez poškození, Mikro odlesk, ...)
///   - 'attrColor'   — barva (zelená, radioaktivní zelená, ...)
///   - 'location'    — lokalita nálezu (Ježkovna, Vrábče, ...)
///
/// `order` ovlivňuje pořadí v dropdownech. `active=false` znamená že hodnota
/// se v UI nezobrazuje pro nové výběry, ale stávající kameny ji mohou držet
/// (kvůli migraci a auditní stopě).
model AttrOption {
  id        Int      @id @default(autoincrement())
  attrKey   String   // 'pasShape' | 'attrDamage' | 'attrColor' | 'location'
  value     String   // čitelná hodnota, ukládá se přímo do Item.{pasShape,attrDamage,attrColor[],location}
  label     String?  // volitelný display label (pokud chybí, použije se `value`)
  /// Anglický překlad — použije se v EN katalogu (eshop/Etsy export, EN locale UI).
  /// Pokud null, fallback na `value`.
  labelEn   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attrKey, value])
  @@index([attrKey, active, sortOrder])
}

model Item {
  id            Int      @id @default(autoincrement())
  evidNumber    String   // e.g. "0001"
  boxId         Int
  box           Box      @relation(fields: [boxId], references: [id])
  name          String   @default("") // název produktu CZ
  nameEn        String   @default("") // název produktu EN
  description   String   @default("") // krátký popis CZ
  descriptionEn String   @default("") // krátký popis EN
  longDescription String @default("") // delší popis CZ (HTML)
  longDescriptionEn String @default("") // delší popis EN (HTML)
  location      String   @default("") // místo nálezu
  storage       String   @default("") // lokace
  purchasePrice Decimal  @default(0) @db.Decimal(10, 2)
  salePrice     Decimal  @default(0) @db.Decimal(10, 2)
  priceEUR      Decimal  @default(0) @db.Decimal(10, 2) // přepočtená cena EUR
  priceUSD      Decimal  @default(0) @db.Decimal(10, 2) // přepočtená cena USD
  weight        Decimal  @default(0) @db.Decimal(8, 2) // gramy
  weightCt      Decimal  @default(0) @db.Decimal(8, 2) // karáty (1g = 5ct)
  sold          Boolean  @default(false) // prodáno
  onShop        Boolean  @default(false) // Upgates eshop
  onEtsy        Boolean  @default(false) // Etsy
  upgatesId     String   @default("") // ID pro Upgates export
  etsyId        String   @default("") // ID pro Etsy export
  certHash      String   @default("") // hash pro verifikační stránku
  certIssuedAt  DateTime? // datum vydání certifikátu
  mainPhoto     Int      @default(1) // index hlavního obrázku (1-24)
  photoPath     String   @default("") // relativní cesta k fotkám
  rangeFolder   String   @default("") // e.g. "0001-0005"
  pasShape      String   @default("") // Primary Aerodynamic Shape — klíč z lib/pasShapes.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── Zakázka (Etapa 1, nullable do backfill v Etapě 2) ───
  // RESTRICT: smazání Order s kameny je blokované — defense in depth
  // proti chybě v API. Soft-delete přes Order.status = CANCELLED.
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // ─── Vstupy do výpočtu ─────────────────────────────────────
  /// Cena za gram v Order.sourceCurrency — override Order.defaultPurchasePricePerGramSource
  purchasePricePerGramSource Decimal? @db.Decimal(10, 2)
  purchasePricePerGramCzk    Decimal? @db.Decimal(10, 2) // přepočet pro výpočet (v1 = source pokud CZK)

  /// Atributy pro maržová pravidla (řízeno přes PricingConfig.rules)
  attrDamage      String   @default("")     // 'none'|'minor'|'major' (snapshot, neenum, řízeno softly)
  attrColor       String[] @default([])     // multi; UI nabízí jen hodnoty z aktivní PricingConfig
  attrCollectible Boolean  @default(false)

  // ─── Výstupy výpočtu (snapshot z posledního přepočtu) ─────
  allocatedOrderCostCzk        Decimal?      @db.Decimal(10, 2)
  /// Cena s náklady = purchasePriceCzk + allocatedOrderCostCzk (řádek "Cena s náklady" v UI)
  costBasisCzk                 Decimal?      @db.Decimal(10, 2)
  computedMarginRate           Decimal?      @db.Decimal(6, 4)  // decimální multiplikátor (1.5 = 150%)
  /// Per-rule rozpis marže z posledního Přepočítat — pro UI tooltip „jaké koeficienty cenotvorby byly použity".
  /// Format: { marginBreakdown: Array<{ ruleKey, matched, marginRate }>, totalMarginRate: string }
  priceCalcBreakdown           Json?
  computedMinPriceExVatCzk     Decimal?      @db.Decimal(10, 2)
  computedMinPriceInclVatCzk   Decimal?      @db.Decimal(10, 2)
  recommendedPriceInclVatCzk   Decimal?      @db.Decimal(10, 2) // po roundingStep, vč. DPH
  /// Cena včetně DPH v měně CZK; uživatel ji může navýšit ≥ recommendedPriceInclVatCzk
  manualPriceInclVatCzk        Decimal?      @db.Decimal(10, 2)
  /// = MAX(recommended, manual ?? recommended). Vstup pro shop/Etsy modifikátor (Etapa 4).
  finalInternalPriceInclVatCzk Decimal?      @db.Decimal(10, 2)
  pricingStatus                PricingStatus @default(NEEDS_INPUT)
  lastCalculatedAt             DateTime?

  // ─── Audit prodeje ─────────────────────────────────────────
  /// Datum kdy kámen přešel z sold=false na sold=true.
  soldAt                       DateTime?
  /// Zafixovaný snapshot výpočtu v okamžiku prodeje — pro dohledatelnost
  /// jak vznikla prodejní cena. Obsahuje rules + breakdown + steps z calculate().
  /// Po nastavení už se nemění — i kdyby user změnil sold zpět a znovu.
  priceCalcSnapshot            Json?
  priceCalcSnapshotAt          DateTime?

  @@unique([boxId, evidNumber])
  @@index([boxId])
  @@index([orderId])
  @@index([onShop])
  @@index([onEtsy])
  @@index([pasShape])
  @@index([pricingStatus])
}

// ─── Order / Zakázka ─────────────────────────────────────────────
// Batch nákupu. Drží metadata + variabilní list nákladů (OrderCostItem).
// Náklady se alokují do kamenů podle allocationMethod (default per Order,
// override per OrderCostItem). Výpočet ceny v lib/pricing/calculate.ts.
model Order {
  id            Int     @id @default(autoincrement())
  code          String  @unique  // "Z2026-001" / "MIG-K0042" / "LEGACY-IMPORT"
  title         String  @default("")
  /// LEGACY free text (zachováno pro migrované zakázky). Pro nové preferuj sellerId FK.
  sellerName    String  @default("")
  sellerContact String  @default("")
  /// FK na Seller entitu — preferovaný způsob u nových zakázek.
  /// Pokud Box.sellerId !== Order.sellerId u některé kazety → UI zobrazí "MIX".
  sellerId      Int?
  seller        Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  purchaseDate  DateTime?
  declaredPieces Int    @default(0)
  declaredWeight Decimal? @db.Decimal(10, 2)
  originLocality String  @default("")
  notes         String  @default("")

  // ─── Currency-ready od v1 (UI v1 jen CZK, ale schema připraveno) ───
  /// Měna nákupu. V1 vždy "CZK", schema je pro v2 (EUR/USD nákupy).
  sourceCurrency            String   @default("CZK")
  totalPurchaseAmountSource Decimal  @db.Decimal(12, 2) @default(0)
  totalPurchaseAmountCzk    Decimal  @db.Decimal(12, 2) @default(0)
  exchangeRate              Decimal? @db.Decimal(12, 6)
  exchangeRateDate          DateTime?

  // ─── Cenotvorba ───────────────────────────────────────────────────
  /// Default cena za gram v sourceCurrency (pro stones bez vlastní PPG)
  defaultPurchasePricePerGramSource Decimal? @db.Decimal(10, 2)
  defaultPurchasePricePerGramCzk    Decimal? @db.Decimal(10, 2)
  allocationMethod                  AllocationMethod @default(BY_WEIGHT)
  vatRatePct                        Decimal  @db.Decimal(5, 2) @default(21.00) // 21.00 = 21%
  roundingStep                      Int      @default(10) // 10 / 50 / 100 Kč

  // ─── PricingConfig — ID pro UI ("jaká config se použila?")
  //     + SNAPSHOT pro reproducibility i po smazání nebo úpravě konfigurace
  pricingConfigId       Int?
  pricingConfig         PricingConfig? @relation(fields: [pricingConfigId], references: [id])
  pricingConfigSnapshot Json?           // celé .rules + missingValuePolicy v okamžiku přepočtu
  pricingConfigVersion  Int?            // verze schématu pravidel (forward-compat)

  // ─── Stav ─────────────────────────────────────────────────────────
  status           OrderStatus @default(DRAFT)
  lastCalculatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]
  boxes Box[]
  costs OrderCostItem[]

  @@index([status])
  @@index([purchaseDate])
  @@index([sellerId])
}

// ─── OrderCostItem / Nákladová položka zakázky ──────────────────────
// Variabilní typ (typeKey + label) místo enumu — přidání nového typu
// nevyžaduje migraci.
model OrderCostItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Normalizovaný klíč pro sumarizaci: 'transport'|'photo'|'packing'|'storage'|'fees'|'customs'|'work'|'other'
  typeKey String
  /// Čitelný popisek (pro typeKey='other' povinný)
  label   String

  /// Per-cost override Order.allocationMethod (NULL = použij Order default)
  allocationMethodOverride AllocationMethod?

  // Currency-ready (v1: vždy CZK, source == czk)
  amountSource     Decimal  @db.Decimal(10, 2)
  amountCzk        Decimal  @db.Decimal(10, 2)
  currency         String   @default("CZK")
  exchangeRate     Decimal? @db.Decimal(12, 6)
  exchangeRateDate DateTime?

  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([typeKey])
}

// ─── PricingConfig ──────────────────────────────────────────────────
// Globálně aktivní konfigurace marží. Order si při přepočtu uloží
// snapshot do Order.pricingConfigSnapshot — tj. PricingConfig lze
// později upravit nebo smazat, staré Order zůstanou reprodukovatelné.
//
// Struktura .rules (JSON):
// {
//   version: 1,
//   missingValuePolicy: 'zero' | 'warn' | 'error',
//   rules: [
//     { key: 'weightBracket', label: 'Velikost (g)', type: 'bracket',
//       missingPolicy: 'error',  // override globálního
//       brackets: [
//         { min: 0, max: 3, marginRate: 1.0 },     // 100% přirážka nad nákupkou
//         { min: 3, max: 10, marginRate: 1.5 },
//         { min: 10, max: null, marginRate: 2.0 }
//       ]
//     },
//     { key: 'pasShape', type: 'category',
//       items: [ { value: 'kapka', marginRate: 0.7 }, ... ] },
//     { key: 'attrColor', type: 'multi-category',
//       combine: 'max',  // 'sum' | 'max' | 'priority-first'
//       items: [ { value: 'namodralá', marginRate: 0.25 }, ... ] },
//     { key: 'attrCollectible', type: 'boolean', marginRate: 0.3 }
//   ]
// }
model PricingConfig {
  id        Int       @id @default(autoincrement())
  name      String                          // "Standardní 2026", "Migrace baseline"
  active    Boolean   @default(false)
  validFrom DateTime?
  validTo   DateTime?
  rules     Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]

  @@index([active])
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  currency  String   // EUR, USD
  rate      Decimal  @db.Decimal(10, 4) // kurz k CZK
  quantity  Int      @default(1)
  source    String   @default("CNB")
  fetchedAt DateTime @default(now())

  @@index([currency])
}

model ExportConfig {
  id             Int      @id @default(autoincrement())
  exportType     String   @unique // "upgates" or "etsy"
  currencies     String[] @default(["CZK"]) // ["CZK", "EUR", "USD"]
  primaryCurrency String  @default("CZK")
  commission     Decimal  @default(0) @db.Decimal(5, 2) // provize v %
  roundPrices    Boolean  @default(true)                  // LEGACY — bude dropnuto v Etapě 4
  roundingStep   Int      @default(10)                    // 10 / 50 / 100 Kč, použije se v Etapě 4 v applyShopModifier
  languages      String[] @default(["cz"]) // ["cz", "en"]
  primaryLanguage String  @default("cz")
  updatedAt      DateTime @updatedAt
}

// ─── Vševěd — znalostní chatbot (Etapa 1) ──────────────────────────────────
// Interní RAG chatbot nad nahranými dokumenty (PDF, DOCX, TXT).
// Embedding dimenze 768 = gemini text-embedding-004 native.
// Tabulka VsevedChunk.embedding používá pgvector typ vector(768)
// s HNSW indexem pro cosine similarity search.

model VsevedDocument {
  id           Int      @id @default(autoincrement())
  title        String
  author       String   @default("")
  year         Int?
  language     String   @default("cs")
  sourceFile   String
  format       String
  fileSize     Int
  textLength   Int      @default(0)
  chunkCount   Int      @default(0)
  status       String   @default("PENDING")
  statusError  String?
  tags         String[] @default([])
  notes        String   @default("")
  uploadedBy   Int
  uploadedAt   DateTime @default(now())
  indexedAt    DateTime?

  chunks       VsevedChunk[]

  @@index([status])
  @@index([language])
}

model VsevedChunk {
  id             Int      @id @default(autoincrement())
  documentId     Int
  document       VsevedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  text           String
  charStart      Int
  charEnd        Int
  pageHint       String?
  tokenCount     Int

  embedding      Unsupported("vector(768)")?

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model VsevedConversation {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String   @default("")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    VsevedMessage[]

  @@index([userId, archived])
}

model VsevedMessage {
  id              Int      @id @default(autoincrement())
  conversationId  Int
  conversation    VsevedConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         String
  citedChunkIds   Int[]    @default([])
  promptTokens    Int?
  responseTokens  Int?
  modelUsed       String?
  createdAt       DateTime @default(now())

  @@index([conversationId, createdAt])
}
